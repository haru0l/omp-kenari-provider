{
  "name": "omp-kenari-provider",
  "version": "0.1.0",
  "description": "omp (oh-my-pi) extension for kenari — OpenAI/Anthropic gateway with free models, images, embeddings, rerank, moderations, judge models, and web search",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/haru0l/omp-kenari-provider.git"
  },
  "keywords": [
    "omp",
    "oh-my-pi",
    "omp-package",
    "kenari",
    "llm",
    "openai",
    "anthropic",
    "gateway",
    "ai",
    "provider"
  ],
  "files": [
    "dist",
    "skills",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run check && npm run build"
  },
  "omp": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "dependencies": {
    "@oh-my-pi/omptype": "^19.0.1",
    "@oh-my-pi/pi-ai": "^19.0.1"
  },
  "peerDependencies": {
    "@oh-my-pi/pi-coding-agent": ">=19.0.1"
  },
  "peerDependenciesMeta": {
    "@oh-my-pi/pi-coding-agent": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.2",
    "@oh-my-pi/pi-coding-agent": "19.0.1",
    "@types/node": "^22.20.5",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
